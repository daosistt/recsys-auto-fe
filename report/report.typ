  table(
    columns: (auto, auto, auto, auto),
    align: center + horizon,
    stroke: none,
    inset: 3pt,
    [*Часть*], [*Выдач*], [*Строк*], [*Клики*],
    table.hline(),
    [Train], [3000], [114 257], [3,97%],
    [Dev], [3000], [110 621], [4,11%],
    table.hline(),
  ),
  caption: [Объём экспериментальной подвыборки.],
